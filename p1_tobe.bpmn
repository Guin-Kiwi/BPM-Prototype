<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="P1_TOBE_Definitions" targetNamespace="https://example.org/cooxupe/comparison" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:message id="T_m1_Message" name="Report"/>
  <bpmn:message id="T_m2_Message" name="Personalised guidance"/>
  <bpmn:message id="T_m3_Message" name="Technician guidance"/>
  <bpmn:process id="P1_TOBE_Process" name="P1 TO-BE — Assisted technical orientation" isExecutable="false">
    <bpmn:documentation>Proposed responsibility routing: request to guidance and recorded outcome Comparison proposal; assumptions and source limits are in NOTES.md.</bpmn:documentation>
    <bpmn:laneSet id="P1_TOBE_LaneSet">
      <bpmn:lane id="T_App" name="Application">
        <bpmn:flowNodeRef>T_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Which</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="T_Coord" name="Advisory coordination / communications role">
        <bpmn:flowNodeRef>T_Routine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_07f6j9c</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_WaitForVisit</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="T_Field" name="Field advisory">
        <bpmn:flowNodeRef>T_Case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0mm53wk</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_ConductVisit</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_0k29adu" name="Yes" sourceRef="Gateway_0mm53wk" targetRef="Activity_07f6j9c"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fieldVisitNeeded</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04kwv40" name="No" sourceRef="Gateway_0mm53wk" targetRef="T_Merge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(fieldVisitNeeded)</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="T_f10" name="" sourceRef="T_Review" targetRef="Gateway_0mm53wk"/>
    <bpmn:sequenceFlow id="T_f12" name="" sourceRef="T_Record" targetRef="T_End"/>
    <bpmn:sequenceFlow id="T_f11" name="" sourceRef="T_Merge" targetRef="T_Record"/>
    <bpmn:sequenceFlow id="T_f09" name="" sourceRef="T_Routine" targetRef="T_Merge"/>
    <bpmn:sequenceFlow id="T_f08" name="" sourceRef="T_Case" targetRef="T_Review"/>
    <bpmn:sequenceFlow id="T_f07" name="Technician" sourceRef="T_Which" targetRef="T_Case">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">technician involvement</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="T_f06" name="Routine" sourceRef="T_Which" targetRef="T_Routine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">routine guidance</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="T_f05" name="" sourceRef="T_Route" targetRef="T_Which"/>
    <bpmn:sequenceFlow id="T_f04" name="" sourceRef="T_Assess" targetRef="T_Route"/>
    <bpmn:sequenceFlow id="T_f03" name="" sourceRef="T_Context" targetRef="T_Assess"/>
    <bpmn:sequenceFlow id="T_f02" name="" sourceRef="T_Register" targetRef="T_Context"/>
    <bpmn:sequenceFlow id="T_f01" name="" sourceRef="T_Start" targetRef="T_Register"/>
    <bpmn:subProcess id="T_Review" name="Review context and advise farmer">
      <bpmn:incoming>T_f08</bpmn:incoming><bpmn:incoming>T_VisitToReview</bpmn:incoming><bpmn:outgoing>T_f10</bpmn:outgoing><bpmn:startEvent id="T_Review_Start">
        <bpmn:outgoing>T_Review_Internal1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_Review_Step1" name="Review full available context and uncertainty">
        <bpmn:incoming>T_Review_Internal1</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_Review_Step2" name="Judge report and case relevance">
        <bpmn:incoming>T_Review_Internal2</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_Review_Step3" name="Clarify the report with the farmer">
        <bpmn:incoming>T_Review_Internal3</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_Review_Step4" name="Prepare and give available guidance">
        <bpmn:incoming>T_Review_Internal4</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_Review_Step5" name="Record findings and current case state">
        <bpmn:incoming>T_Review_Internal5</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="T_Review_End">
        <bpmn:incoming>T_Review_Internal6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="T_Review_Internal1" sourceRef="T_Review_Start" targetRef="T_Review_Step1"/>
      <bpmn:sequenceFlow id="T_Review_Internal2" sourceRef="T_Review_Step1" targetRef="T_Review_Step2"/>
      <bpmn:sequenceFlow id="T_Review_Internal3" sourceRef="T_Review_Step2" targetRef="T_Review_Step3"/>
      <bpmn:sequenceFlow id="T_Review_Internal4" sourceRef="T_Review_Step3" targetRef="T_Review_Step4"/>
      <bpmn:sequenceFlow id="T_Review_Internal5" sourceRef="T_Review_Step4" targetRef="T_Review_Step5"/>
      <bpmn:sequenceFlow id="T_Review_Internal6" sourceRef="T_Review_Step5" targetRef="T_Review_End"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="T_Merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_04kwv40</bpmn:incoming><bpmn:incoming>T_f09</bpmn:incoming><bpmn:outgoing>T_f11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0mm53wk" name="field visit needed?" gatewayDirection="Diverging">
      <bpmn:incoming>T_f10</bpmn:incoming><bpmn:outgoing>Flow_0k29adu</bpmn:outgoing><bpmn:outgoing>Flow_04kwv40</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="T_End" name="Report handling recorded">
      <bpmn:documentation>Ends this report-handling pass only. A technical case remains in its recorded state and is not automatically closed by scheduling, a visit or advice delivery.</bpmn:documentation><bpmn:incoming>T_f12</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="T_Record" name="Record delivery / known outcome">
      <bpmn:incoming>T_f11</bpmn:incoming><bpmn:outgoing>T_f12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T_Routine" name="Relay established guidance">
      <bpmn:incoming>T_f06</bpmn:incoming><bpmn:outgoing>T_f09</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T_Case" name="Create or link technical case">
      <bpmn:incoming>T_f07</bpmn:incoming><bpmn:outgoing>T_f08</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="T_Which" name="Which responsibility?" gatewayDirection="Diverging">
      <bpmn:incoming>T_f05</bpmn:incoming><bpmn:outgoing>T_f07</bpmn:outgoing><bpmn:outgoing>T_f06</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="T_Route" name="DMN: route responsibility">
      <bpmn:incoming>T_f04</bpmn:incoming><bpmn:outgoing>T_f05</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:serviceTask id="T_Assess" name="AI assessment and uncertainty">
      <bpmn:incoming>T_f03</bpmn:incoming><bpmn:outgoing>T_f04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Context" name="Retrieve farm and nearby history">
      <bpmn:incoming>T_f02</bpmn:incoming><bpmn:outgoing>T_f03</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Register" name="Register report">
      <bpmn:incoming>T_f01</bpmn:incoming><bpmn:outgoing>T_f02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:startEvent id="T_Start" name="Report received">
      <bpmn:outgoing>T_f01</bpmn:outgoing><bpmn:messageEventDefinition id="T_Start_Definition" messageRef="T_m1_Message"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_07f6j9c" name="Plan visit and record case status">
      <bpmn:incoming>Flow_0k29adu</bpmn:incoming><bpmn:outgoing>T_PlanToWait</bpmn:outgoing></bpmn:userTask>
  <bpmn:intermediateCatchEvent id="T_WaitForVisit" name="Agreed visit time"><bpmn:incoming>T_PlanToWait</bpmn:incoming><bpmn:outgoing>T_WaitToVisit</bpmn:outgoing><bpmn:timerEventDefinition id="T_WaitForVisit_Timer"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">agreedVisitAt</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:subProcess id="T_ConductVisit" name="Conduct field visit"><bpmn:incoming>T_WaitToVisit</bpmn:incoming><bpmn:outgoing>T_VisitToReview</bpmn:outgoing><bpmn:startEvent id="T_ConductVisit_Start"><bpmn:outgoing>T_ConductVisit_f1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="T_ConductVisit_Travel" name="Travel to farm"><bpmn:incoming>T_ConductVisit_f1</bpmn:incoming><bpmn:outgoing>T_ConductVisit_f2</bpmn:outgoing></bpmn:task><bpmn:task id="T_ConductVisit_Inspect" name="Inspect crops on site"><bpmn:incoming>T_ConductVisit_f2</bpmn:incoming><bpmn:outgoing>T_ConductVisit_f3</bpmn:outgoing></bpmn:task><bpmn:task id="T_ConductVisit_Findings" name="Record visit findings"><bpmn:incoming>T_ConductVisit_f3</bpmn:incoming><bpmn:outgoing>T_ConductVisit_f4</bpmn:outgoing></bpmn:task><bpmn:task id="T_ConductVisit_Return" name="Return from farm"><bpmn:incoming>T_ConductVisit_f4</bpmn:incoming><bpmn:outgoing>T_ConductVisit_f5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="T_ConductVisit_End"><bpmn:incoming>T_ConductVisit_f5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="T_ConductVisit_f1" sourceRef="T_ConductVisit_Start" targetRef="T_ConductVisit_Travel"/><bpmn:sequenceFlow id="T_ConductVisit_f2" sourceRef="T_ConductVisit_Travel" targetRef="T_ConductVisit_Inspect"/><bpmn:sequenceFlow id="T_ConductVisit_f3" sourceRef="T_ConductVisit_Inspect" targetRef="T_ConductVisit_Findings"/><bpmn:sequenceFlow id="T_ConductVisit_f4" sourceRef="T_ConductVisit_Findings" targetRef="T_ConductVisit_Return"/><bpmn:sequenceFlow id="T_ConductVisit_f5" sourceRef="T_ConductVisit_Return" targetRef="T_ConductVisit_End"/></bpmn:subProcess><bpmn:sequenceFlow id="T_PlanToWait" sourceRef="Activity_07f6j9c" targetRef="T_WaitForVisit"/><bpmn:sequenceFlow id="T_WaitToVisit" sourceRef="T_WaitForVisit" targetRef="T_ConductVisit"/><bpmn:sequenceFlow id="T_VisitToReview" sourceRef="T_ConductVisit" targetRef="T_Review"/></bpmn:process>
  <bpmn:collaboration id="P1_TOBE_Collaboration">
    <bpmn:participant id="Farmer" name="Farmer (member)"/>
    <bpmn:participant id="P1_TOBE_Cooxupe" name="Cooxupé · P1 Agricultural technical orientation" processRef="P1_TOBE_Process"/>
    <bpmn:messageFlow id="T_m1" sourceRef="Farmer" targetRef="T_Start" messageRef="T_m1_Message"/>
    <bpmn:messageFlow id="T_m2" sourceRef="T_Routine" targetRef="Farmer" messageRef="T_m2_Message"/>
    <bpmn:messageFlow id="T_m3" sourceRef="T_Review" targetRef="Farmer" messageRef="T_m3_Message"/>
    <bpmn:messageFlow id="Flow_15v1ilz" name="Meeting coordination" sourceRef="Activity_07f6j9c" targetRef="Farmer"/>
    <bpmn:textAnnotation id="T_input">
      <bpmn:text>Report input: photo, estimate, usable device GPS or selected field fallback. No-location handling remains open.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="T_human">
      <bpmn:text>Full available context remains accessible. Technician judges relevance and case links; nearby is not proof. Farm assignments supply continuity; access rules need definition.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="T_severe">
      <bpmn:text>Severe-action bundle and P2/P3 handovers lie outside core P1: subject to human approval and group alignment; diagnosis never automatically skips pickup.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="T_routine_note">
      <bpmn:text>Human relays established advice; product recommendation is optional. Delivery does not establish resolution.</bpmn:text>
    </bpmn:textAnnotation>
  <bpmn:messageFlow id="T_VisitArrangements" sourceRef="Activity_07f6j9c" targetRef="Farmer" name="Visit arrangements"/><bpmn:messageFlow id="T_VisitConfirmation" sourceRef="Farmer" targetRef="Activity_07f6j9c" name="Appointment confirmed"/></bpmn:collaboration>
