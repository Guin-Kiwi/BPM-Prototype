<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="P1_ASIS_Definitions" targetNamespace="https://example.org/cooxupe/comparison" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:message id="A_m1_Message" name="Request for support"/>
  <bpmn:message id="A_m2_Message" name="Agronomic guidance"/>
  <bpmn:message id="A_m3_Message" name="Visit arrangements"/>
  <bpmn:message id="A_m4_Message" name="Slot confirmation"/>
  <bpmn:process id="P1_ASIS_Process" name="P1 AS-IS — Technical orientation" isExecutable="false">
    <bpmn:documentation>Working comparison baseline, not verified Cooxupé practice. Phone diagnosis and the phone/visit choice are group assumptions; the agreed visit timer is an assumption. Sources and activity mapping: docs/reference/README.md and models/comparison/NOTES.md. Process-level monitoring spans requests. Cost analysis must include coordination, round-trip travel and on-site work; quantify technician effort for routine requests and context preparation using comparable measured scenarios. Benefits remain hypotheses.</bpmn:documentation>
    <bpmn:laneSet id="P1_ASIS_LaneSet">
      <bpmn:lane id="A_Field" name="Field advisory">
        <bpmn:flowNodeRef>A_Assessment</bpmn:flowNodeRef><bpmn:flowNodeRef>A_OverviewVisit</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Remote</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Wait</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Visit</bpmn:flowNodeRef><bpmn:flowNodeRef>A_GuidanceMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Document</bpmn:flowNodeRef><bpmn:flowNodeRef>A_End</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="A_Coord" name="Advisory coordination">
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Register</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Allocate</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Schedule</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="A_GuidanceMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>A_RemoteToMerge</bpmn:incoming><bpmn:incoming>A_VisitToMerge</bpmn:incoming><bpmn:outgoing>A_MergeToDoc</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="A_Document" name="Document guidance and progress">
      <bpmn:incoming>A_MergeToDoc</bpmn:incoming><bpmn:outgoing>A_f14</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="A_End" name="Guidance recorded">
      <bpmn:incoming>A_f14</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="A_Start" name="Support requested">
      <bpmn:outgoing>A_f01</bpmn:outgoing><bpmn:messageEventDefinition id="A_Start_Definition" messageRef="A_m1_Message"/>
    </bpmn:startEvent>
    <bpmn:task id="A_Allocate" name="Allocate available technician">
      <bpmn:incoming>A_f02</bpmn:incoming><bpmn:outgoing>A_f03</bpmn:outgoing></bpmn:task>
    <bpmn:task id="A_Register" name="Receive and register request">
      <bpmn:incoming>A_f01</bpmn:incoming><bpmn:outgoing>A_f02</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="A_Wait" name="Agreed visit time">
      <bpmn:incoming>A_sched1</bpmn:incoming><bpmn:outgoing>A_sched2</bpmn:outgoing><bpmn:timerEventDefinition id="A_Wait_Timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">scheduledVisitAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="A_Visit" name="Conduct field visit">
      <bpmn:incoming>A_sched2</bpmn:incoming><bpmn:outgoing>A_VisitToMerge</bpmn:outgoing><bpmn:startEvent id="A_Visit_Start">
        <bpmn:outgoing>A_Visit_Internal1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="A_Visit_Step1" name="Travel to farm">
        <bpmn:incoming>A_Visit_Internal1</bpmn:incoming><bpmn:outgoing>A_Visit_Internal2</bpmn:outgoing></bpmn:task>
      <bpmn:task id="A_Visit_Step2" name="Inspect crops and diagnose on site">
        <bpmn:incoming>A_Visit_Internal2</bpmn:incoming><bpmn:outgoing>A_Visit_Internal3</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="A_Visit_End">
        <bpmn:incoming>A_Visit_Internal5</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="A_Visit_Internal1" sourceRef="A_Visit_Start" targetRef="A_Visit_Step1"/>
      <bpmn:sequenceFlow id="A_Visit_Internal2" sourceRef="A_Visit_Step1" targetRef="A_Visit_Step2"/>
      <bpmn:sequenceFlow id="A_Visit_Internal3" sourceRef="A_Visit_Step2" targetRef="A_Visit_Onsite"/>
    <bpmn:task id="A_Return" name="Return from farm">
      <bpmn:incoming>A_Visit_Internal4</bpmn:incoming><bpmn:outgoing>A_Visit_Internal5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="A_Visit_Onsite" name="Formulate and give on-site guidance"><bpmn:incoming>A_Visit_Internal3</bpmn:incoming><bpmn:outgoing>A_Visit_Internal4</bpmn:outgoing></bpmn:task><bpmn:sequenceFlow id="A_Visit_Internal4" sourceRef="A_Visit_Onsite" targetRef="A_Return"/><bpmn:sequenceFlow id="A_Visit_Internal5" sourceRef="A_Return" targetRef="A_Visit_End"/></bpmn:subProcess>
    <bpmn:subProcess id="A_Schedule" name="Arrange visit with farmer">
      <bpmn:incoming>A_Yes</bpmn:incoming><bpmn:outgoing>A_sched1</bpmn:outgoing><bpmn:startEvent id="A_Schedule_Start">
        <bpmn:outgoing>A_Schedule_i1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="A_Schedule_Agree" name="Agree visit slot with farmer">
        <bpmn:incoming>A_Schedule_i1</bpmn:incoming>
        <bpmn:incoming>A_Schedule_i5</bpmn:incoming>
        <bpmn:outgoing>A_Schedule_i2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="A_Schedule_Slot" name="Slot confirmed?">
        <bpmn:incoming>A_Schedule_i2</bpmn:incoming>
        <bpmn:outgoing>A_Schedule_i3</bpmn:outgoing>
        <bpmn:outgoing>A_Schedule_i4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="A_Schedule_Rearrange" name="Find another visit slot">
        <bpmn:incoming>A_Schedule_i4</bpmn:incoming>
        <bpmn:outgoing>A_Schedule_i5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="A_Schedule_End">
        <bpmn:incoming>A_Schedule_i3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="A_Schedule_i1" name="" sourceRef="A_Schedule_Start" targetRef="A_Schedule_Agree"/>
      <bpmn:sequenceFlow id="A_Schedule_i2" name="" sourceRef="A_Schedule_Agree" targetRef="A_Schedule_Slot"/>
      <bpmn:sequenceFlow id="A_Schedule_i3" name="Yes" sourceRef="A_Schedule_Slot" targetRef="A_Schedule_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">slotConfirmed</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A_Schedule_i4" name="No" sourceRef="A_Schedule_Slot" targetRef="A_Schedule_Rearrange">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(slotConfirmed)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A_Schedule_i5" name="" sourceRef="A_Schedule_Rearrange" targetRef="A_Schedule_Agree"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="A_f14" name="" sourceRef="A_Document" targetRef="A_End"/>
    <bpmn:sequenceFlow id="A_f01" name="" sourceRef="A_Start" targetRef="A_Register"/>
    <bpmn:sequenceFlow id="A_f02" name="" sourceRef="A_Register" targetRef="A_Allocate"/>
    <bpmn:sequenceFlow id="A_sched1" name="" sourceRef="A_Schedule" targetRef="A_Wait"/>
    <bpmn:sequenceFlow id="A_sched2" name="" sourceRef="A_Wait" targetRef="A_Visit"/>
  <bpmn:subProcess id="A_Assessment" name="Assess request with farmer"><bpmn:documentation>The phone/visit choice and diagnosis by phone are working group assumptions, not verified published practice. The result informs the overview visit decision.</bpmn:documentation><bpmn:incoming>A_f03</bpmn:incoming><bpmn:outgoing>A_AssessmentToDecision</bpmn:outgoing><bpmn:startEvent id="A_Assessment_Start"><bpmn:outgoing>A_Assessment_i0</bpmn:outgoing></bpmn:startEvent><bpmn:task id="A_AssessRequest" name="Assess request">
      <bpmn:incoming>A_Assessment_i0</bpmn:incoming><bpmn:outgoing>A_AssessChannel</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="A_Channel" name="Phone or visit?" gatewayDirection="Diverging">
      <bpmn:incoming>A_AssessChannel</bpmn:incoming><bpmn:outgoing>A_f04</bpmn:outgoing><bpmn:outgoing>A_f05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="A_Phone" name="Diagnose by phone">
      <bpmn:incoming>A_f04</bpmn:incoming><bpmn:outgoing>A_f06</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="A_NeedVisit" name="Visit still needed?" gatewayDirection="Diverging">
      <bpmn:incoming>A_f06</bpmn:incoming><bpmn:outgoing>A_f07</bpmn:outgoing><bpmn:outgoing>A_Assessment_iNo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="A_VisitMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>A_f05</bpmn:incoming><bpmn:incoming>A_f07</bpmn:incoming><bpmn:incoming>A_Assessment_iNo</bpmn:incoming><bpmn:outgoing>A_f09</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="A_AssessChannel" name="" sourceRef="A_AssessRequest" targetRef="A_Channel"/>
    <bpmn:sequenceFlow id="A_f04" name="Phone" sourceRef="A_Channel" targetRef="A_Phone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">phone</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_f05" name="Visit" sourceRef="A_Channel" targetRef="A_VisitMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visit</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_f06" name="" sourceRef="A_Phone" targetRef="A_NeedVisit"/>
    <bpmn:sequenceFlow id="A_f07" name="Yes" sourceRef="A_NeedVisit" targetRef="A_VisitMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visit needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_f09" name="" sourceRef="A_VisitMerge" targetRef="A_Assessment_End"/>
    <bpmn:endEvent id="A_Assessment_End"><bpmn:incoming>A_f09</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="A_Assessment_i0" sourceRef="A_Assessment_Start" targetRef="A_AssessRequest"/><bpmn:sequenceFlow id="A_Assessment_iNo" sourceRef="A_NeedVisit" targetRef="A_VisitMerge" name="No"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no visit needed</bpmn:conditionExpression></bpmn:sequenceFlow></bpmn:subProcess><bpmn:subProcess id="A_Remote" name="Provide remote agronomic guidance"><bpmn:incoming>A_No</bpmn:incoming><bpmn:outgoing>A_RemoteToMerge</bpmn:outgoing><bpmn:startEvent id="A_Remote_Start"><bpmn:outgoing>A_Remote_i1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="A_Formulate" name="Formulate recommendation">
      <bpmn:incoming>A_Remote_i1</bpmn:incoming><bpmn:outgoing>A_Remote_i2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="A_Give" name="Give agronomic guidance">
      <bpmn:incoming>A_Remote_i2</bpmn:incoming><bpmn:outgoing>A_Remote_i3</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="A_Remote_End"><bpmn:incoming>A_Remote_i3</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="A_Remote_i1" sourceRef="A_Remote_Start" targetRef="A_Formulate"/><bpmn:sequenceFlow id="A_Remote_i2" sourceRef="A_Formulate" targetRef="A_Give"/><bpmn:sequenceFlow id="A_Remote_i3" sourceRef="A_Give" targetRef="A_Remote_End"/></bpmn:subProcess><bpmn:exclusiveGateway id="A_OverviewVisit" name="Visit needed?" gatewayDirection="Diverging"><bpmn:incoming>A_AssessmentToDecision</bpmn:incoming><bpmn:outgoing>A_Yes</bpmn:outgoing><bpmn:outgoing>A_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="A_f03" sourceRef="A_Allocate" targetRef="A_Assessment"/><bpmn:sequenceFlow id="A_AssessmentToDecision" sourceRef="A_Assessment" targetRef="A_OverviewVisit"/><bpmn:sequenceFlow id="A_Yes" sourceRef="A_OverviewVisit" targetRef="A_Schedule" name="Yes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visit needed</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="A_No" sourceRef="A_OverviewVisit" targetRef="A_Remote" name="No"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no visit needed</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="A_RemoteToMerge" sourceRef="A_Remote" targetRef="A_GuidanceMerge"/><bpmn:sequenceFlow id="A_VisitToMerge" sourceRef="A_Visit" targetRef="A_GuidanceMerge"/><bpmn:sequenceFlow id="A_MergeToDoc" sourceRef="A_GuidanceMerge" targetRef="A_Document"/></bpmn:process>
  <bpmn:collaboration id="P1_ASIS_Collaboration">
    <bpmn:participant id="Farmer" name="Farmer (member)"/>
    <bpmn:participant id="P1_ASIS_Cooxupe" name="Cooxupé · P1 Agricultural technical orientation" processRef="P1_ASIS_Process"/>
    <bpmn:messageFlow id="A_m1" sourceRef="Farmer" targetRef="A_Start" messageRef="A_m1_Message"/>
    <bpmn:messageFlow id="A_m2" sourceRef="A_Remote" targetRef="Farmer" messageRef="A_m2_Message"/>
    <bpmn:messageFlow id="A_m3" sourceRef="A_Schedule" targetRef="Farmer" messageRef="A_m3_Message"/>
    <bpmn:messageFlow id="A_m4" sourceRef="Farmer" targetRef="A_Schedule" messageRef="A_m4_Message"/>
    <bpmn:messageFlow id="A_OnsiteMessage" sourceRef="A_Visit" targetRef="Farmer" messageRef="A_m2_Message"/><bpmn:textAnnotation id="A_Note"><bpmn:text>Phone assessment and visit choice: group assumptions.</bpmn:text></bpmn:textAnnotation></bpmn:collaboration>
  <bpmndi:BPMNDiagram id="P1_ASIS_Collaboration_Diagram"><bpmndi:BPMNPlane id="P1_ASIS_Collaboration_Plane" bpmnElement="P1_ASIS_Collaboration"><bpmndi:BPMNShape id="Farmer_DI" bpmnElement="Farmer" isHorizontal="true"><dc:Bounds x="20" y="20" width="1160" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="P1_ASIS_Cooxupe_DI" bpmnElement="P1_ASIS_Cooxupe" isHorizontal="true"><dc:Bounds x="20" y="110" width="1160" height="650"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_Coord_DI" bpmnElement="A_Coord" isHorizontal="true"><dc:Bounds x="50" y="110" width="1130" height="240"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_Field_DI" bpmnElement="A_Field" isHorizontal="true"><dc:Bounds x="50" y="350" width="1130" height="410"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_Start_DI" bpmnElement="A_Start"><dc:Bounds x="85" y="190" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="95" y="257" width="65" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_Register_DI" bpmnElement="A_Register"><dc:Bounds x="145" y="165" width="145" height="85"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_Allocate_DI" bpmnElement="A_Allocate"><dc:Bounds x="315" y="165" width="145" height="85"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_Assessment_DI" bpmnElement="A_Assessment" isExpanded="false"><dc:Bounds x="490" y="380" width="150" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_OverviewVisit_DI" bpmnElement="A_OverviewVisit" isMarkerVisible="true"><dc:Bounds x="675" y="400" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="650" y="360" width="105" height="34"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_Remote_DI" bpmnElement="A_Remote" isExpanded="false"><dc:Bounds x="755" y="380" width="150" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_GuidanceMerge_DI" bpmnElement="A_GuidanceMerge" isMarkerVisible="true"><dc:Bounds x="945" y="400" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="A_Document_DI" bpmnElement="A