<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="P1_TOBE_Definitions" targetNamespace="https://example.org/cooxupe/comparison" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:message id="T_m1_Message" name="Report" />
  <bpmn:message id="T_m2_Message" name="Personalised guidance" />
  <bpmn:message id="T_m3_Message" name="Technician guidance" />
  <bpmn:message id="T_m4_Message" name="P2 product referral (proposed)" />
  <bpmn:message id="T_m5_Message" name="P2/P3 downstream referral (proposed)" />
  <bpmn:process id="P1_TOBE_Process" name="P1 TO-BE — Assisted technical orientation" isExecutable="false">
    <bpmn:documentation>Proposed comparison, not implemented or group-approved. Sources and unresolved alignment: docs/reference/README.md and models/comparison/NOTES.md. AI assessment is uncertain, DMN routing is proposed, not approved policy. Quantify routine technician effort, context preparation and communications handover with comparable measured scenarios; include scheduling, round-trip travel and on-site work in visit cost. Benefits remain hypotheses. Severe actions and P2/P3 handovers are outside core P1 and require human approval and group alignment; diagnosis never automatically skips pickup.</bpmn:documentation>
    <bpmn:laneSet id="P1_TOBE_LaneSet">
      <bpmn:lane id="T_Field" name="Field advisory">
        <bpmn:flowNodeRef>T_Case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0mm53wk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConductVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_WaitForVisit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="T_Coord" name="Advisory coordination / communications role">
        <bpmn:flowNodeRef>T_Routine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_07f6j9c</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="T_App" name="Application">
        <bpmn:flowNodeRef>T_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Which</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Record</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="T_End" name="Report handling recorded">
      <bpmn:documentation>Ends this report-handling pass only. A technical case remains in its recorded state and is not automatically closed by scheduling, a visit or advice delivery.</bpmn:documentation>
      <bpmn:incoming>T_f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="T_Review" name="Review context and advise farmer">
      <bpmn:documentation>Full available farm history and nearby candidates remain accessible. The technician judges relevance and case links; photo apparent mildness or automatic non-match does not establish irrelevance. History may be unavailable; access rules need definition. Record findings and current case state. Scheduling is handled separately. A downstream P2 product referral or P3 harvest exception is conditional on confirmed human decisions, not automatically triggered by AI severity; any P3 skip-pickup action requires authorisation and group alignment.</bpmn:documentation>
      <bpmn:incoming>T_f08</bpmn:incoming>
      <bpmn:incoming>T_VisitToReview</bpmn:incoming>
      <bpmn:outgoing>T_f10</bpmn:outgoing>
      <bpmn:startEvent id="T_Review_Start">
        <bpmn:outgoing>T_Review_Internal1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_Review_Step1" name="Review full available context and uncertainty">
        <bpmn:incoming>T_Review_Internal1</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_Review_Step2" name="Judge report and case relevance">
        <bpmn:incoming>T_Review_Internal2</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_Review_Step3" name="Clarify the report with the farmer">
        <bpmn:incoming>T_Review_Internal3</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:inclusiveGateway id="T_Review_OrSplit" name="What is appropriate?" gatewayDirection="Diverging">
        <bpmn:incoming>T_Review_Internal4</bpmn:incoming>
        <bpmn:outgoing>T_Review_GuidancePath</bpmn:outgoing>
        <bpmn:outgoing>T_Review_DecisionPath</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:task id="T_Review_Step4" name="Give available preliminary guidance">
        <bpmn:incoming>T_Review_GuidancePath</bpmn:incoming>
        <bpmn:outgoing>T_Review_GuidanceDone</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_Review_VisitDecision" name="Determine whether field visit is needed">
        <bpmn:incoming>T_Review_DecisionPath</bpmn:incoming>
        <bpmn:outgoing>T_Review_DecisionDone</bpmn:outgoing>
      </bpmn:task>
      <bpmn:inclusiveGateway id="T_Review_OrJoin" gatewayDirection="Converging">
        <bpmn:incoming>T_Review_GuidanceDone</bpmn:incoming>
        <bpmn:incoming>T_Review_DecisionDone</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal5</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:sequenceFlow id="T_Review_GuidancePath" sourceRef="T_Review_OrSplit" targetRef="T_Review_Step4">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">guidanceAvailable</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="T_Review_DecisionPath" sourceRef="T_Review_OrSplit" targetRef="T_Review_VisitDecision">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="T_Review_GuidanceDone" sourceRef="T_Review_Step4" targetRef="T_Review_OrJoin" />
      <bpmn:sequenceFlow id="T_Review_DecisionDone" sourceRef="T_Review_VisitDecision" targetRef="T_Review_OrJoin" />
      <bpmn:task id="T_Review_Step5" name="Record findings and current case state">
        <bpmn:incoming>T_Review_Internal5</bpmn:incoming>
        <bpmn:outgoing>T_Review_Internal6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="T_Review_HandoffChoice" name="Downstream referral needed?" gatewayDirection="Diverging">
        <bpmn:incoming>T_Review_Internal6</bpmn:incoming>
        <bpmn:outgoing>T_Review_NoHandoff</bpmn:outgoing>
        <bpmn:outgoing>T_Review_YesHandoff</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="T_Review_Handoff" name="Refer to P2/P3 as appropriate">
        <bpmn:documentation>Proposed downstream message, not a product order or automatic harvest cancellation. Send the relevant P2 referral or explicitly authorised P3 notice; if both are required, they are separate recipients/messages in the downstream integration.</bpmn:documentation>
        <bpmn:incoming>T_Review_YesHandoff</bpmn:incoming>
        <bpmn:outgoing>T_Review_HandoffDone</bpmn:outgoing>
        <bpmn:messageEventDefinition id="T_Review_HandoffDef" messageRef="T_m5_Message" />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="T_Review_End">
        <bpmn:incoming>T_Review_NoHandoff</bpmn:incoming>
        <bpmn:incoming>T_Review_HandoffDone</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="T_Review_Internal1" sourceRef="T_Review_Start" targetRef="T_Review_Step1" />
      <bpmn:sequenceFlow id="T_Review_Internal2" sourceRef="T_Review_Step1" targetRef="T_Review_Step2" />
      <bpmn:sequenceFlow id="T_Review_Internal3" sourceRef="T_Review_Step2" targetRef="T_Review_Step3" />
      <bpmn:sequenceFlow id="T_Review_Internal4" sourceRef="T_Review_Step3" targetRef="T_Review_OrSplit" />
      <bpmn:sequenceFlow id="T_Review_Internal5" sourceRef="T_Review_OrJoin" targetRef="T_Review_Step5" />
      <bpmn:sequenceFlow id="T_Review_Internal6" sourceRef="T_Review_Step5" targetRef="T_Review_HandoffChoice" />
      <bpmn:sequenceFlow id="T_Review_NoHandoff" name="No" sourceRef="T_Review_HandoffChoice" targetRef="T_Review_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(downstreamReferralNeeded)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="T_Review_YesHandoff" name="Yes" sourceRef="T_Review_HandoffChoice" targetRef="T_Review_Handoff">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">downstreamReferralNeeded</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="T_Review_HandoffDone" sourceRef="T_Review_Handoff" targetRef="T_Review_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="T_Routine" name="Relay established guidance">
      <bpmn:documentation>Human communications relays established guidance without diagnosis; product advice is optional. A product need may be referred to P2 for fulfilment, but a referral does not create an order. Delivery does not establish resolution.</bpmn:documentation>
      <bpmn:incoming>T_f06</bpmn:incoming>
      <bpmn:outgoing>T_f09</bpmn:outgoing>
      <bpmn:startEvent id="T_Routine_Start">
        <bpmn:outgoing>T_Routine_i1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_Routine_Relay" name="Relay established guidance">
        <bpmn:incoming>T_Routine_i1</bpmn:incoming>
        <bpmn:outgoing>T_Routine_i2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="T_Routine_ReferChoice" name="P2 referral needed?" gatewayDirection="Diverging">
        <bpmn:incoming>T_Routine_i2</bpmn:incoming>
        <bpmn:outgoing>T_Routine_No</bpmn:outgoing>
        <bpmn:outgoing>T_Routine_Yes</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="T_Routine_Refer" name="Refer product need to P2">
        <bpmn:incoming>T_Routine_Yes</bpmn:incoming>
        <bpmn:outgoing>T_Routine_ReferDone</bpmn:outgoing>
        <bpmn:messageEventDefinition id="T_Routine_ReferDef" messageRef="T_m4_Message" />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="T_Routine_End">
        <bpmn:incoming>T_Routine_No</bpmn:incoming>
        <bpmn:incoming>T_Routine_ReferDone</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="T_Routine_i1" sourceRef="T_Routine_Start" targetRef="T_Routine_Relay" />
      <bpmn:sequenceFlow id="T_Routine_i2" sourceRef="T_Routine_Relay" targetRef="T_Routine_ReferChoice" />
      <bpmn:sequenceFlow id="T_Routine_No" name="No" sourceRef="T_Routine_ReferChoice" targetRef="T_Routine_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(p2ReferralNeeded)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="T_Routine_Yes" name="Yes" sourceRef="T_Routine_ReferChoice" targetRef="T_Routine_Refer">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">p2ReferralNeeded</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="T_Routine_ReferDone" sourceRef="T_Routine_Refer" targetRef="T_Routine_End" />
    </bpmn:subProcess>
    <bpmn:userTask id="T_Case" name="Create or link technical case">
      <bpmn:incoming>T_f07</bpmn:incoming>
      <bpmn:outgoing>T_f08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_Which" name="Who handles report?" gatewayDirection="Diverging">
      <bpmn:incoming>T_f05</bpmn:incoming>
      <bpmn:outgoing>T_f07</bpmn:outgoing>
      <bpmn:outgoing>T_f06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="T_Start" name="Report received">
      <bpmn:outgoing>T_f01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="T_Start_Definition" messageRef="T_m1_Message" />
    </bpmn:startEvent>
    <bpmn:subProcess id="T_Triage" name="AI-assisted report triage">
      <bpmn:documentation>Register report; retrieve available farm and nearby history; assess with AI including uncertainty; route responsibility with deterministic DMN. Proposed capabilities, not implemented. Proposed input: photo, affected-plant estimate and usable device GPS or mapped-field fallback. Handling without usable location remains open; offline capability is not established.</bpmn:documentation>
      <bpmn:incoming>T_f01</bpmn:incoming>
      <bpmn:outgoing>T_f05</bpmn:outgoing>
      <bpmn:startEvent id="T_Triage_Start">
        <bpmn:outgoing>T_Triage_i0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_Register" name="Register report">
        <bpmn:incoming>T_Triage_i0</bpmn:incoming>
        <bpmn:outgoing>T_f02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Context" name="Retrieve farm and nearby history">
        <bpmn:incoming>T_f02</bpmn:incoming>
        <bpmn:outgoing>T_f03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Assess" name="AI assessment and uncertainty">
        <bpmn:incoming>T_f03</bpmn:incoming>
        <bpmn:outgoing>T_f04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:businessRuleTask id="T_Route" name="DMN: route responsibility">
        <bpmn:incoming>T_f04</bpmn:incoming>
        <bpmn:outgoing>T_Triage_iEnd</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sequenceFlow id="T_f02" name="" sourceRef="T_Register" targetRef="T_Context" />
      <bpmn:sequenceFlow id="T_f03" name="" sourceRef="T_Context" targetRef="T_Assess" />
      <bpmn:sequenceFlow id="T_f04" name="" sourceRef="T_Assess" targetRef="T_Route" />
      <bpmn:endEvent id="T_Triage_End">
        <bpmn:incoming>T_Triage_iEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="T_Triage_i0" sourceRef="T_Triage_Start" targetRef="T_Register" />
      <bpmn:sequenceFlow id="T_Triage_iEnd" sourceRef="T_Route" targetRef="T_Triage_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_04kwv40" name="No" sourceRef="Gateway_0mm53wk" targetRef="T_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(fieldVisitNeeded)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="T_f09" name="" sourceRef="T_Routine" targetRef="T_Merge" />
    <bpmn:sequenceFlow id="T_f11" name="" sourceRef="T_Merge" targetRef="T_Record" />
    <bpmn:sequenceFlow id="T_f12" name="" sourceRef="T_Record" targetRef="T_End" />
    <bpmn:sequenceFlow id="T_PlanToWait" sourceRef="Activity_07f6j9c" targetRef="T_WaitForVisit" />
    <bpmn:sequenceFlow id="T_WaitToVisit" sourceRef="T_WaitForVisit" targetRef="T_ConductVisit" />
    <bpmn:sequenceFlow id="T_f08" name="" sourceRef="T_Case" targetRef="T_Review" />
    <bpmn:sequenceFlow id="T_VisitToReview" sourceRef="T_ConductVisit" targetRef="T_Review" />
    <bpmn:sequenceFlow id="T_f10" name="" sourceRef="T_Review" targetRef="Gateway_0mm53wk" />
    <bpmn:sequenceFlow id="Flow_0k29adu" name="Yes" sourceRef="Gateway_0mm53wk" targetRef="Activity_07f6j9c">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fieldVisitNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="T_f06" name="Routine" sourceRef="T_Which" targetRef="T_Routine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">routine guidance</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="T_f07" name="Technician" sourceRef="T_Which" targetRef="T_Case">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">technician involvement</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="T_f05" name="" sourceRef="T_Triage" targetRef="T_Which" />
    <bpmn:sequenceFlow id="T_f01" name="" sourceRef="T_Start" targetRef="T_Triage" />
    <bpmn:exclusiveGateway id="T_Merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_04kwv40</bpmn:incoming>
      <bpmn:incoming>T_f09</bpmn:incoming>
      <bpmn:outgoing>T_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_07f6j9c" name="Plan visit and record case status">
      <bpmn:incoming>Flow_0k29adu</bpmn:incoming>
      <bpmn:outgoing>T_PlanToWait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Record" name="Record delivery / known outcome">
      <bpmn:documentation>Record delivery and known outcome; a technical case remains in its recorded state. Delivery does not imply resolution or closure.</bpmn:documentation>
      <bpmn:incoming>T_f11</bpmn:incoming>
      <bpmn:outgoing>T_f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0mm53wk" name="Field visit needed?" gatewayDirection="Diverging">
      <bpmn:incoming>T_f10</bpmn:incoming>
      <bpmn:outgoing>Flow_0k29adu</bpmn:outgoing>
      <bpmn:outgoing>Flow_04kwv40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="T_ConductVisit" name="Conduct field visit">
      <bpmn:incoming>T_WaitToVisit</bpmn:incoming>
      <bpmn:outgoing>T_VisitToReview</bpmn:outgoing>
      <bpmn:startEvent id="T_ConductVisit_Start">
        <bpmn:outgoing>T_ConductVisit_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_ConductVisit_Travel" name="Travel to farm">
        <bpmn:incoming>T_ConductVisit_f1</bpmn:incoming>
        <bpmn:outgoing>T_ConductVisit_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_ConductVisit_Inspect" name="Inspect crops on site">
        <bpmn:incoming>T_ConductVisit_f2</bpmn:incoming>
        <bpmn:outgoing>T_ConductVisit_f3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:userTask id="T_ConductVisit_Findings" name="Enter visit findings">
        <bpmn:incoming>T_ConductVisit_f3</bpmn:incoming>
        <bpmn:outgoing>T_ConductVisit_f4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_ConductVisit_Save" name="Save findings to case history">
        <bpmn:incoming>T_ConductVisit_f4</bpmn:incoming>
        <bpmn:outgoing>T_ConductVisit_fSave</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:task id="T_ConductVisit_Return" name="Return from farm">
        <bpmn:incoming>T_ConductVisit_fSave</bpmn:incoming>
        <bpmn:outgoing>T_ConductVisit_f5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="T_ConductVisit_End">
        <bpmn:incoming>T_ConductVisit_f5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="T_ConductVisit_f1" sourceRef="T_ConductVisit_Start" targetRef="T_ConductVisit_Travel" />
      <bpmn:sequenceFlow id="T_ConductVisit_f2" sourceRef="T_ConductVisit_Travel" targetRef="T_ConductVisit_Inspect" />
      <bpmn:sequenceFlow id="T_ConductVisit_f3" sourceRef="T_ConductVisit_Inspect" targetRef="T_ConductVisit_Findings" />
      <bpmn:sequenceFlow id="T_ConductVisit_f4" sourceRef="T_ConductVisit_Findings" targetRef="T_ConductVisit_Save" />
      <bpmn:sequenceFlow id="T_ConductVisit_fSave" sourceRef="T_ConductVisit_Save" targetRef="T_ConductVisit_Return" />
      <bpmn:sequenceFlow id="T_ConductVisit_f5" sourceRef="T_ConductVisit_Return" targetRef="T_ConductVisit_End" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="T_WaitForVisit" name="Agreed visit time">
      <bpmn:incoming>T_PlanToWait</bpmn:incoming>
      <bpmn:outgoing>T_WaitToVisit</bpmn:outgoing>
      <bpmn:timerEventDefinition id="T_WaitForVisit_Timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">agreedVisitAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
  <bpmn:collaboration id="P1_TOBE_Collaboration">
    <bpmn:participant id="Farmer" name="Farmer (member)" />
    <bpmn:participant id="P1_TOBE_Cooxupe" name="Cooxupé · P1 Agricultural technical orientation" processRef="P1_TOBE_Process" />
    <bpmn:messageFlow id="T_m1" sourceRef="Farmer" targetRef="T_Start" messageRef="T_m1_Message" />
    <bpmn:messageFlow id="T_m2" sourceRef="T_Routine" targetRef="Farmer" messageRef="T_m2_Message" />
    <bpmn:messageFlow id="T_m3" sourceRef="T_Review" targetRef="Farmer" messageRef="T_m3_Message" />
    <bpmn:messageFlow id="T_VisitArrangements" name="Visit arrangements" sourceRef="Activity_07f6j9c" targetRef="Farmer" />
    <bpmn:messageFlow id="T_VisitConfirmation" name="Appointment confirmed" sourceRef="Farmer" targetRef="Activity_07f6j9c" />
    <bpmn:textAnnotation id="T_triage_note">
      <bpmn:text>Register report; farm/nearby history; AI assessment; DMN routing.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="T_human">
      <bpmn:text>Available history and nearby candidates; technician judges relevance.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="T_severe">
      <bpmn:text>Severe actions / P2–P3: human approval and alignment outside core P1.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="T_routine_note">
      <bpmn:text>Established guidance; product advice optional.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="P1_TOBE_Collaboration_Diagram">
    <bpmndi:BPMNPlane id="P1_TOBE_Collaboration_Plane" bpmnElement="P1_TOBE_Collaboration">
      <bpmndi:BPMNShape id="Farmer_DI" bpmnElement="Farmer" isHorizontal="true">
