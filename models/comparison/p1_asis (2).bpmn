  <bpmndi:BPMNDiagram id="A_Visit_DetailDiagram">
    <bpmndi:BPMNPlane id="A_Visit_DetailPlane" bpmnElement="A_Visit">
      <bpmndi:BPMNShape id="A_Visit_Start_DetailDI" bpmnElement="A_Visit_Start">
        <dc:Bounds x="150" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Visit_Step1_DetailDI" bpmnElement="A_Visit_Step1">
        <dc:Bounds x="330" y="80" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Visit_Step2_DetailDI" bpmnElement="A_Visit_Step2">
        <dc:Bounds x="510" y="80" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Visit_Onsite_DetailDI" bpmnElement="A_Visit_Onsite">
        <dc:Bounds x="750" y="80" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Return_DetailDI" bpmnElement="A_Return">
        <dc:Bounds x="1010" y="80" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Visit_End_DetailDI" bpmnElement="A_Visit_End">
        <dc:Bounds x="1242" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A_Visit_Internal1_DetailDI" bpmnElement="A_Visit_Internal1">
        <di:waypoint x="186" y="120" />
        <di:waypoint x="330" y="120" />
