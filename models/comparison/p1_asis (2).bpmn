        <dc:Bounds x="20" y="110" width="1160" height="590" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Coord_DI" bpmnElement="A_Coord" isHorizontal="true">
        <dc:Bounds x="50" y="110" width="1130" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Field_DI" bpmnElement="A_Field" isHorizontal="true">
        <dc:Bounds x="50" y="350" width="1130" height="350" />
      </bpmndi:BPMNShape>
