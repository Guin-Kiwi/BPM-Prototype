        <bpmndi:BPMNLabel>
          <dc:Bounds x="535" y="460" width="140" height="25"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A_f05_DI" bpmnElement="A_f05">
        <di:waypoint x="505" y="515"/>
