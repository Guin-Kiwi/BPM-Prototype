        <di:waypoint x="920" y="650"/>
        <di:waypoint x="920" y="635"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="600" y="628" width="140" height="25"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A_f06_DI" bpmnElement="A_f06">
        <di:waypoint x="705" y="487.5"/>
        <di:waypoint x="745" y="490.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A_f07_DI" bpmnElement="A_f07">
        <di:waypoint x="770" y="515"/>
        <di:waypoint x="770" y="610"/>
