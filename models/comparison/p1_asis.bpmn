<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="P1_ASIS_Definitions" targetNamespace="https://example.org/cooxupe/comparison">
  <bpmn:message id="A_m1_Message" name="Request for support"/>
  <bpmn:message id="A_m2_Message" name="Agronomic guidance"/>
  <bpmn:message id="A_m3_Message" name="Visit arrangements"/>
  <bpmn:message id="A_m4_Message" name="Slot confirmation"/>
  <bpmn:process id="P1_ASIS_Process" name="P1 AS-IS — Technical orientation" isExecutable="false">
    <bpmn:documentation>Working draft and team assumptions: request to guidance and documentation Comparison proposal; assumptions and source limits are in NOTES.md.</bpmn:documentation>
    <bpmn:laneSet id="P1_ASIS_LaneSet">
      <bpmn:lane id="A_Coord" name="Advisory coordination">
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Wait</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A_Field" name="Field advisory">
        <bpmn:flowNodeRef>A_Channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_NeedVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_VisitMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_GuidanceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Formulate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ReturnDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RecordMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AssessRequest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_Start" name="Support requested">
      <bpmn:outgoing>A_f01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="A_Start_Definition" messageRef="A_m1_Message"/>
    </bpmn:startEvent>
    <bpmn:task id="A_Register" name="Receive and register request">
      <bpmn:incoming>A_f01</bpmn:incoming>
      <bpmn:outgoing>A_f02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Allocate" name="Allocate available technician">
      <bpmn:incoming>A_f02</bpmn:incoming>
      <bpmn:outgoing>A_f03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_Channel" name="Phone or visit?" gatewayDirection="Diverging">
      <bpmn:incoming>A_AssessChannel</bpmn:incoming>
      <bpmn:outgoing>A_f04</bpmn:outgoing>
      <bpmn:outgoing>A_f05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Phone" name="Diagnose by phone">
      <bpmn:incoming>A_f04</bpmn:incoming>
      <bpmn:outgoing>A_f06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_NeedVisit" name="Visit still needed?" gatewayDirection="Diverging">
      <bpmn:incoming>A_f06</bpmn:incoming>
      <bpmn:outgoing>A_f07</bpmn:outgoing>
      <bpmn:outgoing>A_f08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="A_VisitMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>A_f05</bpmn:incoming>
      <bpmn:incoming>A_f07</bpmn:incoming>
      <bpmn:outgoing>A_f09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="A_Visit" name="Travel and inspect farm">
      <bpmn:incoming>A_sched2</bpmn:incoming>
      <bpmn:outgoing>A_f10</bpmn:outgoing>
      <bpmn:startEvent id="A_Visit_Start">
        <bpmn:outgoing>A_Visit_Internal1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="A_Visit_Step1" name="Travel to farm">
        <bpmn:incoming>A_Visit_Internal1</bpmn:incoming>
        <bpmn:outgoing>A_Visit_Internal2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A_Visit_Step2" name="Inspect crops and diagnose on site">
        <bpmn:incoming>A_Visit_Internal2</bpmn:incoming>
        <bpmn:outgoing>A_Visit_Internal3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="A_Visit_End">
        <bpmn:incoming>A_Visit_Internal3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="A_Visit_Internal1" sourceRef="A_Visit_Start" targetRef="A_Visit_Step1"/>
      <bpmn:sequenceFlow id="A_Visit_Internal2" sourceRef="A_Visit_Step1" targetRef="A_Visit_Step2"/>
      <bpmn:sequenceFlow id="A_Visit_Internal3" sourceRef="A_Visit_Step2" targetRef="A_Visit_End"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="A_GuidanceMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>A_f08</bpmn:incoming>
      <bpmn:incoming>A_f10</bpmn:incoming>
      <bpmn:outgoing>A_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Formulate" name="Formulate recommendation">
      <bpmn:incoming>A_f11</bpmn:incoming>
      <bpmn:outgoing>A_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Give" name="Give agronomic guidance">
      <bpmn:incoming>A_f12</bpmn:incoming>
      <bpmn:outgoing>A_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Document" name="Document request and guidance">
      <bpmn:incoming>A_docJoin</bpmn:incoming>
      <bpmn:outgoing>A_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_End" name="Guidance recorded">
      <bpmn:incoming>A_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="A_Schedule" name="Arrange visit with farmer">
      <bpmn:incoming>A_f09</bpmn:incoming>
      <bpmn:outgoing>A_sched1</bpmn:outgoing>
      <bpmn:startEvent id="A_Schedule_Start">
        <bpmn:outgoing>A_Schedule_i1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="A_Schedule_Agree" name="Agree visit slot with farmer">
        <bpmn:incoming>A_Schedule_i1</bpmn:incoming>
        <bpmn:incoming>A_Schedule_i5</bpmn:incoming>
        <bpmn:outgoing>A_Schedule_i2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="A_Schedule_Slot" name="Slot confirmed?">
        <bpmn:incoming>A_Schedule_i2</bpmn:incoming>
        <bpmn:outgoing>A_Schedule_i3</bpmn:outgoing>
        <bpmn:outgoing>A_Schedule_i4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="A_Schedule_Rearrange" name="Find another visit slot">
        <bpmn:incoming>A_Schedule_i4</bpmn:incoming>
        <bpmn:outgoing>A_Schedule_i5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="A_Schedule_End">
        <bpmn:incoming>A_Schedule_i3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="A_Schedule_i1" sourceRef="A_Schedule_Start" targetRef="A_Schedule_Agree" name=""/>
      <bpmn:sequenceFlow id="A_Schedule_i2" sourceRef="A_Schedule_Agree" targetRef="A_Schedule_Slot" name=""/>
      <bpmn:sequenceFlow id="A_Schedule_i3" sourceRef="A_Schedule_Slot" targetRef="A_Schedule_End" name="Yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">slotConfirmed</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A_Schedule_i4" sourceRef="A_Schedule_Slot" targetRef="A_Schedule_Rearrange" name="No">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(slotConfirmed)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A_Schedule_i5" sourceRef="A_Schedule_Rearrange" targetRef="A_Schedule_Agree" name=""/>
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="A_Wait" name="Agreed visit time">
      <bpmn:incoming>A_sched1</bpmn:incoming>
      <bpmn:outgoing>A_sched2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="A_Wait_Timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">scheduledVisitAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="A_ReturnDecision" name="Visit occurred?" gatewayDirection="Diverging">
      <bpmn:incoming>A_f13</bpmn:incoming>
      <bpmn:outgoing>A_returnYes</bpmn:outgoing>
      <bpmn:outgoing>A_returnNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Return" name="Return from farm">
      <bpmn:incoming>A_returnYes</bpmn:incoming>
      <bpmn:outgoing>A_returnJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_RecordMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>A_returnNo</bpmn:incoming>
      <bpmn:incoming>A_returnJoin</bpmn:incoming>
      <bpmn:outgoing>A_docJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_AssessRequest" name="Assess request">
      <bpmn:incoming>A_f03</bpmn:incoming>
      <bpmn:outgoing>A_AssessChannel</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="A_f01" sourceRef="A_Start" targetRef="A_Register" name=""/>
    <bpmn:sequenceFlow id="A_f02" sourceRef="A_Register" targetRef="A_Allocate" name=""/>
    <bpmn:sequenceFlow id="A_f03" sourceRef="A_Allocate" targetRef="A_AssessRequest" name=""/>
    <bpmn:sequenceFlow id="A_f04" sourceRef="A_Channel" targetRef="A_Phone" name="Phone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">phone</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_f05" sourceRef="A_Channel" targetRef="A_VisitMerge" name="Visit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visit</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_f06" sourceRef="A_Phone" targetRef="A_NeedVisit" name=""/>
    <bpmn:sequenceFlow id="A_f07" sourceRef="A_NeedVisit" targetRef="A_VisitMerge" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visit needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_f08" sourceRef="A_NeedVisit" targetRef="A_GuidanceMerge" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no visit needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_f10" sourceRef="A_Visit" targetRef="A_GuidanceMerge" name=""/>
    <bpmn:sequenceFlow id="A_f11" sourceRef="A_GuidanceMerge" targetRef="A_Formulate" name=""/>
    <bpmn:sequenceFlow id="A_f12" sourceRef="A_Formulate" targetRef="A_Give" name=""/>
    <bpmn:sequenceFlow id="A_f09" sourceRef="A_VisitMerge" targetRef="A_Schedule" name=""/>
    <bpmn:sequenceFlow id="A_sched1" sourceRef="A_Schedule" targetRef="A_Wait" name=""/>
    <bpmn:sequenceFlow id="A_sched2" sourceRef="A_Wait" targetRef="A_Visit" name=""/>
    <bpmn:sequenceFlow id="A_f13" sourceRef="A_Give" targetRef="A_ReturnDecision" name=""/>
    <bpmn:sequenceFlow id="A_returnYes" sourceRef="A_ReturnDecision" targetRef="A_Return" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visit occurred</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_returnNo" sourceRef="A_ReturnDecision" targetRef="A_RecordMerge" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no visit</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A_returnJoin" sourceRef="A_Return" targetRef="A_RecordMerge" name=""/>
    <bpmn:sequenceFlow id="A_docJoin" sourceRef="A_RecordMerge" targetRef="A_Document" name=""/>
    <bpmn:sequenceFlow id="A_f14" sourceRef="A_Document" targetRef="A_End" name=""/>
    <bpmn:sequenceFlow id="A_AssessChannel" sourceRef="A_AssessRequest" targetRef="A_Channel" name=""/>
    <bpmn:textAnnotation id="A_note1">
      <bpmn:text>Phone / visit flow: working-draft assumptions, not validated operation. Farmer waits for and hosts a visit. Timer assumes an agreed visit date.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_note2">
      <bpmn:text>Process-level status collection and monitoring meetings span requests; they are not per-request steps.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:collaboration id="P1_ASIS_Collaboration">
    <bpmn:participant id="Farmer" name="Farmer (member)"/>
    <bpmn:participant id="P1_ASIS_Cooxupe" name="Cooxupé · P1 Agricultural technical orientation" processRef="P1_ASIS_Process"/>
    <bpmn:messageFlow id="A_m1" name="Request for support" sourceRef="Farmer" targetRef="A_Start" messageRef="A_m1_Message"/>
    <bpmn:messageFlow id="A_m2" name="Agronomic guidance" sourceRef="A_Give" targetRef="Farmer" messageRef="A_m2_Message"/>
    <bpmn:messageFlow id="A_m3" name="Visit arrangements" sourceRef="A_Schedule" targetRef="Farmer" messageRef="A_m3_Message"/>
    <bpmn:messageFlow id="A_m4" name="Slot confirmation" sourceRef="Farmer" targetRef="A_Schedule" messageRef="A_m4_Message"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="P1_ASIS_Diagram">
